<!-- Onglet 3 : Import retour terrain -->
<widget class="QWidget" name="tab_import">
 <attribute name="title">
  <string>Transférer le GeoPackage</string>
 </attribute>

 <layout class="QVBoxLayout" name="verticalLayout_import">

  <!-- Sélection GeoPackage retour -->
  <item>
   <widget class="QGroupBox" name="gb_selection_gpkg_import">
    <property name="title">
