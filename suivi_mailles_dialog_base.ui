<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>SuiviMaillesDialogBase</class>
 <widget class="QDialog" name="SuiviMaillesDialogBase">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>550</width>
    <height>500</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Suivi faune/flore par mailles</string>
  </property>

  <layout class="QVBoxLayout" name="verticalLayout_main">
   <item>
    <widget class="QTabWidget" name="tabWidget">
     <property name="currentIndex">
      <number>0</number>
     </property>

     <!-- Onglet 1 : Préparation bureau -->
     <widget class="QWidget" name="tab_preparation">
      <attribute name="title">
       <string>Préparation bureau</string>
      </attribute>

      <layout class="QVBoxLayout" name="verticalLayout_preparation">

       <!-- Paramètres du suivi -->
       <item>
        <widget class="QGroupBox" name="gb_parametres_suivi">
         <property name="title">
          <string>Paramètres du suivi</string>
         </property>

         <layout class="QFormLayout" name="formLayout_parametres_suivi">
            <item row="0" column="0">
                <widget class="QLabel" name="label_site">
                <property name="text">
                <string>Site :</string>
                </property>
                </widget>
            </item>
            
            <item row="0" column="1">
            <widget class="QLineEdit" name="site">
            <property name="placeholderText">
            <string>Tapez le nom du site...</string>
            </property>
            <property name="clearButtonEnabled">
            <bool>true</bool>
            </property>
            </widget>
            </item>

          <item row="1" column="0">
           <widget class="QLabel" name="label_taille_maille">
            <property name="text">
             <string>Taille de maille :</string>
            </property>
           </widget>
          </item>
          
          <item row="1" column="1">
           <widget class="QComboBox" name="cb_taille_maille">
            <item>
             <property name="text">
              <string>5 m</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>10 m</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>25 m</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>50 m</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>100 m</string>
             </property>
            </item>
           </widget>
          </item>

          <item row="2" column="0">
           <widget class="QLabel" name="label_date_suivi">
            <property name="text">
             <string>Date du suivi :</string>
            </property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QDateEdit" name="date_suivi">
            <property name="calendarPopup">
             <bool>true</bool>
            </property>
            <property name="displayFormat">
             <string>dd/MM/yyyy</string>
            </property>
           </widget>
          </item>

          <item row="3" column="0">
           <widget class="QLabel" name="label_groupe">
            <property name="text">
             <string>Groupe :</string>
            </property>
           </widget>
          </item>
          <item row="3" column="1">
           <widget class="QComboBox" name="cb_groupe">
            <item>
             <property name="text">
              <string>faune</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>flore</string>
             </property>
            </item>
           </widget>
          </item>


          <item row="4" column="0">
           <widget class="QLabel" name="label_espece">
            <property name="text">
             <string>Espèce :</string>
            </property>
           </widget>
         </item>
         
        <item row="4" column="1">
        <widget class="QLineEdit" name="espece">
        <property name="placeholderText">
        <string>Tapez le nom d'espèce...</string>
        </property>
        <property name="clearButtonEnabled">
        <bool>true</bool>
        </property>
        </widget>
        </item>

        <item row="5" column="0">
        <widget class="QLabel" name="label_observateur">
        <property name="text">
        <string>Observateur principal :</string>
        </property>
        </widget>
        </item>
        <item row="5" column="1">
        <widget class="QLineEdit" name="observateur">
        <property name="placeholderText">
        <string>Tapez le nom d'observateur...</string>
        </property>
        <property name="clearButtonEnabled">
        <bool>true</bool>
        </property>
        </widget>
        </item>

    
         </layout>
        </widget>
       </item>

       <!-- Recherche du suivi existant -->
       <item>
        <widget class="QGroupBox" name="gb_recherche_suivi">
         <property name="title">
          <string>Recherche du suivi existant</string>
         </property>

         <layout class="QVBoxLayout" name="verticalLayout_recherche_suivi">

          <item>
           <widget class="QLabel" name="label_recherche_suivi_info">
            <property name="text">
             <string>Le plugin recherchera un suivi existant avec les paramètres saisis ci-dessus.</string>
            </property>
            <property name="wordWrap">
             <bool>true</bool>
            </property>
           </widget>
          </item>

          <item>
           <widget class="QPushButton" name="btn_rechercher_suivi">
            <property name="text">
             <string>Rechercher le suivi</string>
            </property>
           </widget>
          </item>

         </layout>
        </widget>
       </item>

       <!-- Export GeoPackage -->
       <item>
        <widget class="QGroupBox" name="gb_export_gpkg">
         <property name="title">
          <string>Export GeoPackage</string>
         </property>

         <layout class="QFormLayout" name="formLayout_export_gpkg">

          <item row="0" column="0">
           <widget class="QLabel" name="label_fichier_gpkg_export">
            <property name="text">
             <string>Fichier GeoPackage :</string>
            </property>
           </widget>
          </item>

          <item row="0" column="1">
           <layout class="QHBoxLayout" name="horizontalLayout_fichier_gpkg_export">
            <item>
             <widget class="QLineEdit" name="le_fichier_gpkg_export">
              <property name="placeholderText">
               <string>Choisir le fichier .gpkg à créer...</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="btn_parcourir_export">
              <property name="text">
               <string>Parcourir...</string>
              </property>
             </widget>
            </item>
           </layout>
          </item>

         </layout>
        </widget>
       </item>

       <!-- Actions -->
       <item>
        <widget class="QGroupBox" name="gb_actions_preparation">
         <property name="title">
          <string>Actions</string>
         </property>

         <layout class="QHBoxLayout" name="horizontalLayout_actions_preparation">

          <item>
           <widget class="QPushButton" name="btn_creer_suivi">
            <property name="text">
             <string>Créer le suivi</string>
            </property>
           </widget>
          </item>

          <item>
           <widget class="QPushButton" name="btn_export_gpkg">
            <property name="text">
             <string>Exporter le GeoPackage</string>
            </property>
           </widget>
          </item>

         </layout>
        </widget>
       </item>



      </layout>
     </widget>

     <!-- Onglet 2 -->
<!-- Onglet 2 : Suivi terrain -->
<widget class="QWidget" name="tab_terrain">
 <attribute name="title">
  <string>Réalisation du suivi</string>
 </attribute>

 <layout class="QVBoxLayout" name="verticalLayout_terrain">

  <!-- Chargement GeoPackage terrain -->
  <item>
   <widget class="QGroupBox" name="gb_chargement_gpkg_terrain">
    <property name="title">
     <string>GeoPackage terrain</string>
    </property>

    <layout class="QFormLayout" name="formLayout_chargement_gpkg_terrain">

     <item row="0" column="0">
      <widget class="QLabel" name="label_fichier_gpkg_terrain">
