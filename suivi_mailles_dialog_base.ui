        <string>Fichier GeoPackage :</string>
       </property>
      </widget>
     </item>

     <item row="0" column="1">
      <layout class="QHBoxLayout" name="horizontalLayout_fichier_gpkg_terrain">
       <item>
        <widget class="QLineEdit" name="le_fichier_gpkg_terrain">
         <property name="placeholderText">
          <string>Sélectionner le GeoPackage terrain...</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QPushButton" name="btn_parcourir_terrain">
         <property name="text">
          <string>...</string>
         </property>
        </widget>
       </item>
      </layout>
     </item>

     <item row="1" column="0">
      <widget class="QLabel" name="label_couche_mailles_terrain">
       <property name="text">
        <string>Couche mailles :</string>
       </property>
      </widget>
     </item>

     <item row="1" column="1">
      <widget class="QLineEdit" name="le_couche_mailles_terrain">
       <property name="readOnly">
        <bool>true</bool>
       </property>
       <property name="placeholderText">
        <string>mailles_suivi</string>
       </property>
      </widget>
     </item>

    </layout>
   </widget>
  </item>

  <!-- Actions chargement -->
  <item>
   <widget class="QGroupBox" name="gb_actions_chargement_terrain">
    <property name="title">
     <string>Chargement</string>
    </property>

    <layout class="QHBoxLayout" name="horizontalLayout_actions_chargement_terrain">

     <item>
      <widget class="QPushButton" name="btn_charger_gpkg_terrain">
       <property name="text">
        <string>Charger le GeoPackage</string>
       </property>
      </widget>
     </item>

     <item>
      <widget class="QPushButton" name="btn_zoom_mailles_terrain">
       <property name="text">
        <string>Zoom sur les mailles</string>
       </property>
      </widget>
     </item>

    </layout>
   </widget>
  </item>

  <!-- Suivi actif (session multi-espèces) -->
  <item>
   <widget class="QGroupBox" name="gb_suivi_actif_terrain">
    <property name="title">
     <string>Suivi actif</string>
    </property>

    <layout class="QVBoxLayout" name="verticalLayout_suivi_actif_terrain">

     <item>
      <layout class="QHBoxLayout" name="horizontalLayout_suivi_actif_terrain">
       <item>
        <widget class="QComboBox" name="cb_suivi_actif_terrain"/>
       </item>
       <item>
        <widget class="QPushButton" name="btn_decharger_suivi_terrain">
         <property name="text">
          <string>Décharger</string>
         </property>
        </widget>
       </item>
      </layout>
     </item>

     <item>
      <widget class="QLabel" name="label_suivi_actif_terrain">
       <property name="text">
        <string>Aucun suivi actif</string>
       </property>
       <property name="alignment">
        <set>Qt::AlignCenter</set>
       </property>
      </widget>
     </item>

    </layout>
   </widget>
  </item>

  <!-- Localisation GPS -->
  <item>
   <widget class="QGroupBox" name="gb_gps_terrain">
    <property name="title">
     <string>Localisation GPS</string>
    </property>

    <layout class="QHBoxLayout" name="horizontalLayout_gps_terrain">

     <item>
      <widget class="QToolButton" name="tb_open_gps_panel">
       <property name="toolTip">
        <string>Ouvrir le panneau GPS de QGIS</string>
       </property>
       <property name="text">
        <string>GPS</string>
       </property>
       <property name="iconSize">
        <size>
         <width>32</width>
         <height>32</height>
        </size>
       </property>
       <property name="toolButtonStyle">
        <enum>Qt::ToolButtonIconOnly</enum>
       </property>
       <property name="autoRaise">
        <bool>true</bool>
       </property>
      </widget>
     </item>

     <item>
      <widget class="QLabel" name="label_gps_info">
       <property name="text">
        <string>Afficher la position GPS de la tablette dans QGIS.</string>
       </property>
       <property name="wordWrap">
        <bool>true</bool>
       </property>
      </widget>
     </item>

    </layout>
   </widget>
  </item>


  <!-- Mode clic terrain -->
  <item>
   <widget class="QGroupBox" name="gb_mode_clic_terrain">
    <property name="title">
     <string>Mode clic de suivi</string>
    </property>

    <layout class="QVBoxLayout" name="verticalLayout_mode_clic_terrain">

     <item>
      <widget class="QLabel" name="label_mode_clic_info">
       <property name="text">
        <string>Le mode clic permet de modifier presence_absence directement en cliquant sur une maille dans QGIS.</string>
       </property>
       <property name="wordWrap">
        <bool>true</bool>
       </property>
      </widget>
     </item>

     <item>
      <layout class="QHBoxLayout" name="horizontalLayout_mode_clic_terrain">

       <item>
        <widget class="QPushButton" name="btn_lancer_suivi">
         <property name="text">
          <string>Lancer le suivi</string>
         </property>
        </widget>
       </item>

       <item>
        <widget class="QPushButton" name="btn_arreter_suivi">
         <property name="text">
          <string>Arrêter le suivi</string>
         </property>
         <property name="enabled">
          <bool>false</bool>
         </property>
        </widget>
       </item>

      </layout>
     </item>

    </layout>
   </widget>
  </item>

  <!-- Sauvegarde -->
  <item>
   <widget class="QGroupBox" name="gb_sauvegarde_terrain">
    <property name="title">
