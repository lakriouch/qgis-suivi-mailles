     <!-- Onglet 4 -->
<!-- Onglet 4 : Journal  -->
<widget class="QWidget" name="tab_journal">
 <attribute name="title">
  <string>Journal</string>
 </attribute>

 <layout class="QVBoxLayout" name="verticalLayout_journal">

  <item>
   <widget class="QLabel" name="lbl_journal">
    <property name="text">
     <string>Journal des opérations du plugin</string>
    </property>
    <property name="styleSheet">
     <string notr="true">font-weight: bold; font-size: 12pt;</string>
    </property>
   </widget>
  </item>

  <item>
   <widget class="QPlainTextEdit" name="txt_journal">
    <property name="readOnly">
     <bool>true</bool>
    </property>
    <property name="placeholderText">
     <string>Les messages de préparation, terrain et import apparaîtront ici...</string>
    </property>
   </widget>
  </item>

  <item>
   <layout class="QHBoxLayout" name="horizontalLayout_actions_journal">

    <item>
     <widget class="QPushButton" name="btn_effacer_journal">
      <property name="text">
       <string>Effacer le journal</string>
      </property>
     </widget>
    </item>

    <item>
     <spacer name="horizontalSpacer_journal">
      <property name="orientation">
       <enum>Qt::Horizontal</enum>
      </property>
      <property name="sizeHint" stdset="0">
       <size>
        <width>40</width>
        <height>20</height>
       </size>
      </property>
     </spacer>
    </item>

   </layout>
  </item>

 </layout>
</widget>

    </widget>
   </item>
  </layout>
